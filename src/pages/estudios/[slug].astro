---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getEstudios } from '../../data'
import { EstudioPage } from '../../components/pages/EstudioPage'

import { NotFoundPage } from '../../components/pages/NotFoundPage'

export function getStaticPaths() {
  return getEstudios().map((estudio) => ({
    params: { slug: estudio.slug },
    props: { estudio },
  }))
}

const { estudio } = Astro.props

// Si el estudio no existe o está deshabilitado en esta compilación
if (!estudio) {
  return Astro.redirect('/404');
}

const keywords = [
  'Cubadata',
  'Cuba',
  'estudio',
  'análisis',
  ...estudio.keywords ?? []
]
---

<BaseLayout
  title={`${estudio.title} - Cubadata`}
  description={(estudio.summary[0] ?? estudio.excerpt) ?? ''}
  keywords={keywords}
  image={estudio.image}
  canonicalPath={`/estudios/${estudio.slug}`}
  activePage="/estudios"
  type="article"
>
  <EstudioPage slug={estudio.slug} client:load />
</BaseLayout>
