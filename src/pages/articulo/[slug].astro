---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getArticles } from '../../data'
import { ArticlePage } from '../../components/pages/ArticlePage'

import { NotFoundPage } from '../../components/pages/NotFoundPage'

export function getStaticPaths() {
  return getArticles().map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }))
}

const { article } = Astro.props

// Si el artículo no existe o está deshabilitado en esta compilación
if (!article) {
  return Astro.redirect('/404');
}

const keywords = [
  'Cubadata',
  'Cuba',
  'articulo',
  'análisis',
  ...article.keywords ?? []
]
---

<BaseLayout
  title={`${article.title} - Cubadata`}
  description={(article.summary[0] ?? article.excerpt) ?? ''}
  keywords={keywords}
  image={article.image}
  canonicalPath={`/articulo/${article.slug}`}
  activePage="/articulo"
  type="article"
>
  <ArticlePage slug={article.slug} client:load />
</BaseLayout>
