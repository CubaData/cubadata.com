---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getEncuestas } from '../../data'
import { EncuestaPage } from '../../components/pages/EncuestaPage'

export function getStaticPaths() {
  return getEncuestas().map((encuesta) => ({
    params: { slug: encuesta.slug },
    props: { encuesta },
  }))
}

const { encuesta } = Astro.props
const keywords = [
  'Cubadata',
  'Cuba',
  'encuesta',
  'opinión pública',
  ...encuesta.keywords ?? []
]
---

<BaseLayout
  title={`${encuesta.title} - Cubadata`}
  description={(encuesta.summary[0] ?? encuesta.excerpt) ?? ''}
  keywords={keywords}
  image={encuesta.image}
  canonicalPath={`/encuestas/${encuesta.slug}`}
  activePage="/encuestas"
  type="article"
>
  <EncuestaPage slug={encuesta.slug} client:load />
</BaseLayout>
